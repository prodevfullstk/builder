# Google Gemini API credentials for Opendork AI Web Builder
# Configure these in your Vercel Project Settings -> Environment Variables
GEMINI_API_KEY=""
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GROQ_API_KEY=""
GROQ_API_URL="https://api.groq.com/openai/v1"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres.[ref]:[password]@[pooler-host]:5432/postgres"
DIRECT_URL="postgresql://postgres.[ref]:[password]@[pooler-host]:5432/postgres"

# AI Orchestration Settings
ORCHESTRATION_ENABLED="true"  # Enable multi-step intelligent task orchestration (default: true)
